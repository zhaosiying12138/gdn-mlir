      %St_31 = arith.truncf %Sa_31 : f32 to bf16
      memref.store %St_31, %S[%rAh_sd_7, %nct_sd_0] : memref<128x64xbf16, #gpu.address_space<workgroup>>
      %eS_32 = vector.extract %mr_sd_7_0_48[1, 1] : f32 from vector<2x2xf32>
      %Sv_32 = memref.load %S[%rAh_sd_7, %nct1_sd_0] : memref<128x64xbf16, #gpu.address_space<workgroup>>
      %Sf_32 = arith.extf %Sv_32 : bf16 to f32
      %Sm_32 = arith.mulf %Sf_32, %dl : f32
      %Sa_32 = arith.addf %Sm_32, %eS_32 : f32
      %St_32 = arith.truncf %Sa_32 : f32 to bf16
      memref.store %St_32, %S[%rAh_sd_7, %nct1_sd_0] : memref<128x64xbf16, #gpu.address_space<workgroup>>
      gpu.barrier
      }
      scf.for %ci_8 = %tid to %c8192 step %c256 {
      %idv_8 = arith.divsi %ci_8, %c64 : index
      %irm_8 = arith.remsi %ci_8, %c64 : index
      %cgs = memref.load %S[%idv_8, %irm_8] : memref<128x64xbf16, #gpu.address_space<workgroup>>
      %cgc = arith.extf %cgs : bf16 to f32
      %im_32 = arith.muli %idv_8, %c128 : index
      %ix_796 = arith.addi %im_32, %irm_8 : index
      %ix_797 = arith.addi %ix, %ix_796 : index
      memref.store %cgc, %ht[%ix_797] : memref<65536xf32>
      }
  gpu.terminator
  }
  return
}
