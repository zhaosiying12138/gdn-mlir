    %cCm1 = arith.constant 63 : index
    %cNC = arith.constant 2 : index
    %f0 = arith.constant 0.0 : f32
    %f1 = arith.constant 1.0 : f32
    %fscale = arith.constant 0.25 : f32
    %o = memref.alloc() : memref<1x128x2x16xf32>
    %ht = memref.alloc() : memref<1x2x16x16xf32>
    scf.for %b = %c0 to %cB step %c1 {
      scf.for %h = %c0 to %cH step %c1 {
        // scratch
        %S = memref.alloc() : memref<16x16xf32>
        %Abuf = memref.alloc() : memref<64x64xf32>
        %Tbuf = memref.alloc() : memref<64x64xf32>
        %kkt = memref.alloc() : memref<64x64xf32>
        %qk = memref.alloc() : memref<64x64xf32>
        %gc = memref.alloc() : memref<64xf32>
        %upre = memref.alloc() : memref<64x16xf32>
        %ubuf = memref.alloc() : memref<64x16xf32>
        %kb2 = memref.alloc() : memref<64x16xf32>
        %wp = memref.alloc() : memref<64x16xf32>
        %vp = memref.alloc() : memref<64x16xf32>
        %vn = memref.alloc() : memref<64x16xf32>
        %qg = memref.alloc() : memref<64x16xf32>
        %kg = memref.alloc() : memref<64x16xf32>
        %oib = memref.alloc() : memref<64x16xf32>
        %oob = memref.alloc() : memref<64x16xf32>
        %prod = memref.alloc() : memref<16x16xf32>
        %h0h = memref.subview %h0[%b, %h, 0, 0] [1, 1, 16, 16] [1, 1, 1, 1] : memref<1x2x16x16xf32> to memref<16x16xf32, strided<[16, 1], offset: ?>>
        linalg.copy ins(%h0h : memref<16x16xf32, strided<[16, 1], offset: ?>>) outs(%S : memref<16x16xf32>)
        %q_bh = memref.subview %q[%b, 0, %h, 0] [1, 128, 1, 16] [1, 1, 1, 1] : memref<1x128x2x16xf32> to memref<128x16xf32, strided<[32, 1], offset: ?>>
        %k_bh = memref.subview %k[%b, 0, %h, 0] [1, 128, 1, 16] [1, 1, 1, 1] : memref<1x128x2x16xf32> to memref<128x16xf32, strided<[32, 1], offset: ?>>
        %v_bh = memref.subview %v[%b, 0, %h, 0] [1, 128, 1, 16] [1, 1, 1, 1] : memref<1x128x2x16xf32> to memref<128x16xf32, strided<[32, 1], offset: ?>>
        %beta_bh = memref.subview %beta[%b, 0, %h] [1, 128, 1] [1, 1, 1] : memref<1x128x2xf32> to memref<128xf32, strided<[2], offset: ?>>
        %g_bh = memref.subview %g[%b, 0, %h] [1, 128, 1] [1, 1, 1] : memref<1x128x2xf32> to memref<128xf32, strided<[2], offset: ?>>
        %o_bh = memref.subview %o[%b, 0, %h, 0] [1, 128, 1, 16] [1, 1, 1, 1] : memref<1x128x2x16xf32> to memref<128x16xf32, strided<[32, 1], offset: ?>>
        scf.for %n = %c0 to %cNC step %c1 {
          %off = arith.muli %n, %cC : index
          %q_c = memref.subview %q_bh[%off, 0] [64, 16] [1, 1] : memref<128x16xf32, strided<[32, 1], offset: ?>> to memref<64x16xf32, strided<[32, 1], offset: ?>>
          %k_c = memref.subview %k_bh[%off, 0] [64, 16] [1, 1] : memref<128x16xf32, strided<[32, 1], offset: ?>> to memref<64x16xf32, strided<[32, 1], offset: ?>>
          %v_c = memref.subview %v_bh[%off, 0] [64, 16] [1, 1] : memref<128x16xf32, strided<[32, 1], offset: ?>> to memref<64x16xf32, strided<[32, 1], offset: ?>>
          %beta_c = memref.subview %beta_bh[%off] [64] [1] : memref<128xf32, strided<[2], offset: ?>> to memref<64xf32, strided<[2], offset: ?>>
          %g_c = memref.subview %g_bh[%off] [64] [1] : memref<128xf32, strided<[2], offset: ?>> to memref<64xf32, strided<[2], offset: ?>>
          %o_c = memref.subview %o_bh[%off, 0] [64, 16] [1, 1] : memref<128x16xf32, strided<[32, 1], offset: ?>> to memref<64x16xf32, strided<[32, 1], offset: ?>>
          // (a) gc = inclusive cumsum(g)
          %g0v = memref.load %g_c[%c0] : memref<64xf32, strided<[2], offset: ?>>
          memref.store %g0v, %gc[%c0] : memref<64xf32>
          scf.for %i = %c1 to %cC step %c1 {
            %ip = arith.subi %i, %c1 : index
            %prev = memref.load %gc[%ip] : memref<64xf32>
            %cur = memref.load %g_c[%i] : memref<64xf32, strided<[2], offset: ?>>
            %cs = arith.addf %prev, %cur : f32
            memref.store %cs, %gc[%i] : memref<64xf32>
          }
          %gcl = memref.load %gc[%cCm1] : memref<64xf32>
          // (b) A = strict_tril(beta_i * (k k^T)_ij * 2^(gc_i-gc_j))
          linalg.fill ins(%f0 : f32) outs(%kkt : memref<64x64xf32>)
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, j, r) -> (i, r)>,
                  affine_map<(i, j, r) -> (j, r)>,
                  affine_map<(i, j, r) -> (i, j)>
                ],
                iterator_types = ["parallel", "parallel", "reduction"]
              } ins(%k_c, %k_c : memref<64x16xf32, strided<[32, 1], offset: ?>>, memref<64x16xf32, strided<[32, 1], offset: ?>>) outs(%kkt : memref<64x64xf32>) {
            ^bb0(%a: f32, %b2: f32, %acc: f32):
            %p = arith.mulf %a, %b2 : f32
            %s2 = arith.addf %acc, %p : f32
            linalg.yield %s2 : f32
          }
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, j) -> (i, j)>,
                  affine_map<(i, j) -> (i)>,
                  affine_map<(i, j) -> (j)>,
                  affine_map<(i, j) -> (i)>,
                  affine_map<(i, j) -> (i, j)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%kkt, %gc, %gc, %beta_c : memref<64x64xf32>, memref<64xf32>, memref<64xf32>, memref<64xf32, strided<[2], offset: ?>>) outs(%Abuf : memref<64x64xf32>) {
            ^bb0(%kk: f32, %gi: f32, %gj: f32, %bt: f32, %out: f32):
            %d0 = arith.subf %gi, %gj : f32
            %e0 = math.exp2 %d0 : f32
            %m0 = arith.mulf %kk, %bt : f32
            %m1 = arith.mulf %m0, %e0 : f32
            %i0 = linalg.index 0 : index
            %j0 = linalg.index 1 : index
            %lt = arith.cmpi slt, %j0, %i0 : index
            %r0 = arith.select %lt, %m1, %f0 : f32
            linalg.yield %r0 : f32
          }
          // (c) T = (I + A)^-1 via forward substitution
          linalg.fill ins(%f0 : f32) outs(%Tbuf : memref<64x64xf32>)
          scf.for %i2 = %c0 to %cC step %c1 {
            memref.store %f1, %Tbuf[%i2, %i2] : memref<64x64xf32>
            scf.for %j2 = %c0 to %i2 step %c1 {
              %sum = scf.for %k2 = %j2 to %i2 step %c1 iter_args(%acc2 = %f0) -> (f32) {
                %aik = memref.load %Abuf[%i2, %k2] : memref<64x64xf32>
                %tkj = memref.load %Tbuf[%k2, %j2] : memref<64x64xf32>
                %pk = arith.mulf %aik, %tkj : f32
                %ak = arith.addf %acc2, %pk : f32
                scf.yield %ak : f32
              }
              %neg = arith.negf %sum : f32
              memref.store %neg, %Tbuf[%i2, %j2] : memref<64x64xf32>
            }
          }
          // (d) u = T @ (beta .* v), w = T @ (beta .* k .* 2.^gc)
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i)>,
                  affine_map<(i, d) -> (i, d)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%v_c, %beta_c : memref<64x16xf32, strided<[32, 1], offset: ?>>, memref<64xf32, strided<[2], offset: ?>>) outs(%upre : memref<64x16xf32>) {
            ^bb0(%xv: f32, %bt1: f32, %out1: f32):
            %r1 = arith.mulf %xv, %bt1 : f32
            linalg.yield %r1 : f32
          }
          linalg.fill ins(%f0 : f32) outs(%ubuf : memref<64x16xf32>)
          linalg.matmul ins(%Tbuf, %upre : memref<64x64xf32>, memref<64x16xf32>) outs(%ubuf : memref<64x16xf32>)
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i)>,
                  affine_map<(i, d) -> (i)>,
                  affine_map<(i, d) -> (i, d)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%k_c, %beta_c, %gc : memref<64x16xf32, strided<[32, 1], offset: ?>>, memref<64xf32, strided<[2], offset: ?>>, memref<64xf32>) outs(%kb2 : memref<64x16xf32>) {
            ^bb0(%xk: f32, %bt2: f32, %gI: f32, %out2: f32):
            %e2 = math.exp2 %gI : f32
            %m3 = arith.mulf %xk, %bt2 : f32
            %r2 = arith.mulf %m3, %e2 : f32
            linalg.yield %r2 : f32
          }
          linalg.fill ins(%f0 : f32) outs(%wp : memref<64x16xf32>)
          linalg.matmul ins(%Tbuf, %kb2 : memref<64x64xf32>, memref<64x16xf32>) outs(%wp : memref<64x16xf32>)
          // (e) v_new = u - w @ S
          linalg.fill ins(%f0 : f32) outs(%vp : memref<64x16xf32>)
          linalg.matmul ins(%wp, %S : memref<64x16xf32>, memref<16x16xf32>) outs(%vp : memref<64x16xf32>)
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i, d)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%ubuf, %vp : memref<64x16xf32>, memref<64x16xf32>) outs(%vn : memref<64x16xf32>) {
            ^bb0(%xu: f32, %xv2: f32, %out3: f32):
            %r3 = arith.subf %xu, %xv2 : f32
            linalg.yield %r3 : f32
          }
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i)>,
                  affine_map<(i, d) -> (i, d)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%q_c, %gc : memref<64x16xf32, strided<[32, 1], offset: ?>>, memref<64xf32>) outs(%qg : memref<64x16xf32>) {
            ^bb0(%xq: f32, %gI2: f32, %out4: f32):
            %e3 = math.exp2 %gI2 : f32
            %r4 = arith.mulf %xq, %e3 : f32
            linalg.yield %r4 : f32
          }
          linalg.fill ins(%f0 : f32) outs(%oob : memref<64x16xf32>)
          linalg.matmul ins(%qg, %S : memref<64x16xf32>, memref<16x16xf32>) outs(%oob : memref<64x16xf32>)
          linalg.fill ins(%f0 : f32) outs(%qk : memref<64x64xf32>)
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, j, r) -> (i, r)>,
                  affine_map<(i, j, r) -> (j, r)>,
                  affine_map<(i, j, r) -> (i, j)>
                ],
                iterator_types = ["parallel", "parallel", "reduction"]
              } ins(%q_c, %k_c : memref<64x16xf32, strided<[32, 1], offset: ?>>, memref<64x16xf32, strided<[32, 1], offset: ?>>) outs(%qk : memref<64x64xf32>) {
            ^bb0(%a2: f32, %b3: f32, %acc3: f32):
            %p2 = arith.mulf %a2, %b3 : f32
            %s3 = arith.addf %acc3, %p2 : f32
            linalg.yield %s3 : f32
          }
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, j) -> (i, j)>,
                  affine_map<(i, j) -> (i)>,
                  affine_map<(i, j) -> (j)>,
                  affine_map<(i, j) -> (i, j)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%qk, %gc, %gc : memref<64x64xf32>, memref<64xf32>, memref<64xf32>) outs(%Abuf : memref<64x64xf32>) {
            ^bb0(%qq: f32, %gi3: f32, %gj3: f32, %out5: f32):
            %d3 = arith.subf %gi3, %gj3 : f32
            %e4 = math.exp2 %d3 : f32
            %m4 = arith.mulf %qq, %e4 : f32
            %i3 = linalg.index 0 : index
            %j3 = linalg.index 1 : index
            %le = arith.cmpi sle, %j3, %i3 : index
            %r5 = arith.select %le, %m4, %f0 : f32
            linalg.yield %r5 : f32
          }
          linalg.fill ins(%f0 : f32) outs(%oib : memref<64x16xf32>)
          linalg.matmul ins(%Abuf, %vn : memref<64x64xf32>, memref<64x16xf32>) outs(%oib : memref<64x16xf32>)
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i, d)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%oob, %oib : memref<64x16xf32>, memref<64x16xf32>) outs(%o_c : memref<64x16xf32, strided<[32, 1], offset: ?>>) {
            ^bb0(%xa: f32, %xb: f32, %out6: f32):
            %ad = arith.addf %xa, %xb : f32
            %sc = arith.mulf %ad, %fscale : f32
            linalg.yield %sc : f32
          }
          %dl = math.exp2 %gcl : f32
          linalg.generic {
                indexing_maps = [
                  affine_map<(i, d) -> (i, d)>,
                  affine_map<(i, d) -> (i)>,
                  affine_map<(i, d) -> (i, d)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%k_c, %gc : memref<64x16xf32, strided<[32, 1], offset: ?>>, memref<64xf32>) outs(%kg : memref<64x16xf32>) {
            ^bb0(%xk2: f32, %gI4: f32, %out7: f32):
            %dg = arith.subf %gcl, %gI4 : f32
            %eg = math.exp2 %dg : f32
            %r6 = arith.mulf %xk2, %eg : f32
            linalg.yield %r6 : f32
          }
          linalg.fill ins(%f0 : f32) outs(%prod : memref<16x16xf32>)
          linalg.generic {
                indexing_maps = [
                  affine_map<(kk, vv, i) -> (i, kk)>,
                  affine_map<(kk, vv, i) -> (i, vv)>,
                  affine_map<(kk, vv, i) -> (kk, vv)>
                ],
                iterator_types = ["parallel", "parallel", "reduction"]
              } ins(%kg, %vn : memref<64x16xf32>, memref<64x16xf32>) outs(%prod : memref<16x16xf32>) {
            ^bb0(%a4: f32, %b4: f32, %acc4: f32):
            %p4 = arith.mulf %a4, %b4 : f32
            %s4 = arith.addf %acc4, %p4 : f32
            linalg.yield %s4 : f32
          }
          linalg.generic {
                indexing_maps = [
                  affine_map<(a, b) -> (a, b)>,
                  affine_map<(a, b) -> (a, b)>,
                  affine_map<(a, b) -> (a, b)>
                ],
                iterator_types = ["parallel", "parallel"]
              } ins(%S, %prod : memref<16x16xf32>, memref<16x16xf32>) outs(%S : memref<16x16xf32>) {
            ^bb0(%xs: f32, %xp: f32, %out8: f32):
            %ms = arith.mulf %xs, %dl : f32
            %rs = arith.addf %ms, %xp : f32
            linalg.yield %rs : f32
          }
        }
        %hth = memref.subview %ht[%b, %h, 0, 0] [1, 1, 16, 16] [1, 1, 1, 1] : memref<1x2x16x16xf32> to memref<16x16xf32, strided<[16, 1], offset: ?>>
        linalg.copy ins(%S : memref<16x16xf32>) outs(%hth : memref<16x16xf32, strided<[16, 1], offset: ?>>)
        memref.dealloc %S : memref<16x16xf32>
        memref.dealloc %Abuf : memref<64x64xf32>
        memref.dealloc %Tbuf : memref<64x64xf32>
        memref.dealloc %kkt : memref<64x64xf32>
        memref.dealloc %qk : memref<64x64xf32>
        memref.dealloc %gc : memref<64xf32>
        memref.dealloc %upre : memref<64x16xf32>
        memref.dealloc %ubuf : memref<64x16xf32>
        memref.dealloc %kb2 : memref<64x16xf32>
        memref.dealloc %wp : memref<64x16xf32>
        memref.dealloc %vp : memref<64x16xf32>
        memref.dealloc %vn : memref<64x16xf32>
        memref.dealloc %qg : memref<64x16xf32>
        memref.dealloc %kg : memref<64x16xf32>
        memref.dealloc %oib : memref<64x16xf32>
        memref.dealloc %oob : memref<64x16xf32>
        memref.dealloc %prod : memref<16x16xf32>
      }
    }
    return %o, %ht : memref<1x128x2x16xf32>, memref<1x2x16x16xf32>
  }
  
  func.func @main() {
    %q = memref.get_global @q : memref<1x128x2x16xf32>
    %k = memref.get_global @k : memref<1x128x2x16xf32>
    %v = memref.get_global @v : memref<1x128x2x16xf32>
    %beta = memref.get_global @beta : memref<1x128x2xf32>
    %g = memref.get_global @g : memref<1x128x2xf32>
    %h0 = memref.get_global @h0 : memref<1x2x16x16xf32>
    %o, %ht = func.call @gdn_fwd(%q, %k, %v, %beta, %g, %h0) : (memref<1x128x2x16xf32>, memref<1x128x2x16xf32>, memref<1x128x2x16xf32>, memref<1x128x2xf32>, memref<1x128x2xf32>, memref<1x2x16x16xf32>) -> (memref<1x128x2x16xf32>, memref<1x2x16x16xf32>)
    %o_ = memref.cast %o : memref<1x128x2x16xf32> to memref<*xf32>
    call @printMemrefF32(%o_) : (memref<*xf32>) -> ()
    %ht_ = memref.cast %ht : memref<1x2x16x16xf32> to memref<*xf32>
    call @printMemrefF32(%ht_) : (memref<*xf32>) -> ()
    return
  }
}
